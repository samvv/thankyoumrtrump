---
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('events', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);

const events = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const years = Map.groupBy(events, ({ entry }) => entry.data.date.getUTCFullYear());

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric' });

const scopeLabel = { america: 'America', world: 'The world', both: 'America and the world' };
const categoryLabel = (category: string) => category.replace('-', ' ');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A grateful timeline of what Donald Trump and his circle have done for America and the world."
		/>
		<title>Thank You, Mr. Trump</title>
	</head>
	<body>
		<header>
			<h1>Thank You, Mr.&nbsp;Trump</h1>
			<p>A grateful record of everything you and your friends have done for America and the world.</p>
		</header>

		<main>
			{
				[...years].map(([year, yearEvents]) => (
					<section>
						<h2>{year}</h2>
						<ol>
							{yearEvents.map(({ entry, Content }) => (
								<li id={entry.id}>
									<time datetime={entry.data.date.toISOString().slice(0, 10)}>
										{formatDate(entry.data.date)}
									</time>
									<p class="thanks">{entry.data.thanks}</p>
									<h3>{entry.data.title}</h3>
									<div class="body">
										<Content />
									</div>
									<dl>
										<div>
											<dt>Courtesy of</dt>
											<dd>{entry.data.actors.join(', ')}</dd>
										</div>
										<div>
											<dt>Paid for by</dt>
											<dd>{scopeLabel[entry.data.scope]}</dd>
										</div>
										<div>
											<dt>Filed under</dt>
											<dd class="category">{categoryLabel(entry.data.category)}</dd>
										</div>
										<div>
											<dt>Sources</dt>
											<dd>
												{entry.data.sources.map((source) => (
													<a href={source.url} rel="noopener">
														{source.title}
													</a>
												))}
											</dd>
										</div>
									</dl>
								</li>
							))}
						</ol>
					</section>
				))
			}
		</main>

		<footer>
			<p>Every entry links to its sources. The gratitude is sarcastic; the facts are not.</p>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: #faf7f2;
		--text: #1d1b19;
		--muted: #6b655d;
		--rule: #d9d2c6;
		--accent: #a3261b;
		--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
		--sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #171514;
			--text: #ece7df;
			--muted: #a29a8f;
			--rule: #3a3531;
			--accent: #ef7a6c;
		}
	}

	body {
		margin: 0;
		padding: 0 1rem;
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		line-height: 1.6;
	}

	header,
	main,
	footer {
		max-width: 40rem;
		margin-inline: auto;
	}

	header {
		padding-block: 4rem 2.5rem;
		border-bottom: 1px solid var(--rule);
	}

	h1 {
		margin: 0 0 0.75rem;
		font-family: var(--serif);
		font-size: clamp(2.25rem, 8vw, 3.5rem);
		font-style: italic;
		font-weight: 600;
		line-height: 1.1;
		text-wrap: balance;
	}

	header p {
		margin: 0;
		color: var(--muted);
		font-size: 1.125rem;
		text-wrap: pretty;
	}

	h2 {
		margin: 3rem 0 1.5rem;
		font-family: var(--serif);
		font-size: 1.75rem;
		font-variant-numeric: tabular-nums;
		color: var(--accent);
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid var(--rule);
	}

	li {
		position: relative;
		padding: 0 0 2.5rem 1.5rem;
	}

	li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 0.45rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--bg);
	}

	time {
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.thanks {
		margin: 0.25rem 0 0.5rem;
		font-family: var(--serif);
		font-size: 1.5rem;
		font-style: italic;
		line-height: 1.3;
		text-wrap: balance;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 600;
		text-wrap: pretty;
	}

	.body :global(p) {
		margin: 0 0 0.75rem;
		text-wrap: pretty;
	}

	dl {
		display: grid;
		gap: 0.25rem;
		margin: 1rem 0 0;
		font-size: 0.875rem;
	}

	dl div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0.75rem;
	}

	dt {
		color: var(--muted);
	}

	dd {
		margin: 0;
	}

	.category {
		text-transform: capitalize;
	}

	dd a {
		display: block;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.15em;
	}

	footer {
		padding-block: 2rem 4rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
