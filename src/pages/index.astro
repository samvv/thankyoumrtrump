---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('events', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const events = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const years = Map.groupBy(events, ({ entry }) => entry.data.date.getUTCFullYear());
const newestYear = entries.at(0)?.data.date.getUTCFullYear();
const oldestYear = entries.at(-1)?.data.date.getUTCFullYear();

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric' });

// The site may be served from a sub-path (e.g. GitHub Pages project sites).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const scopeLabel = { america: 'America', world: 'The world', both: 'America and the world' };
const categoryLabel = (category: string) => category.replace('-', ' ');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A grateful timeline of what Donald Trump and his circle have done for America and the world."
		/>
		<title>Thank You, Mr. Trump</title>
	</head>
	<body>
		<header>
			<div class="card">
				<svg class="seal" viewBox="0 0 120 120" aria-hidden="true">
					<defs>
						<path id="seal-arc" d="M16 60a44 44 0 1 1 88 0a44 44 0 1 1-88 0" />
					</defs>
					<circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="2" />
					<circle cx="60" cy="60" r="52.5" fill="none" stroke="currentColor" stroke-width="0.75" />
					<circle cx="60" cy="60" r="34" fill="none" stroke="currentColor" stroke-width="0.75" />
					<text fill="currentColor" font-size="9" font-weight="700">
						<textPath href="#seal-arc" textLength="270">WITH GRATITUDE ★ SINCERELY YOURS ★</textPath>
					</text>
					<g transform="translate(60 60) scale(1.55) translate(-16 -16.5)" fill="currentColor">
						<path d="M13.4 8 18.6 8 22.5 24 16 30.5 9.5 24Z" />
						<path d="M12 2.5 20 2.5 18.6 7.2 13.4 7.2Z" />
					</g>
				</svg>
				<p class="overline">A note of thanks</p>
				<h1>Thank You, Mr.&nbsp;Trump</h1>
				<p class="lede">
					A grateful record of everything you and your friends have done for America and the world.
				</p>
				<p class="signature">
					With sincere appreciation,
					<span>America &amp; the rest of the world</span>
				</p>
			</div>
			<nav aria-label="Jump to year">
				<span>{events.length} reasons to be thankful, {oldestYear}–{newestYear}</span>
				<ul>
					{[...years.keys()].map((year) => (
						<li>
							<a href={`#y${year}`}>{year}</a>
						</li>
					))}
				</ul>
			</nav>
		</header>

		<main>
			{
				[...years].map(([year, yearEvents]) => (
					<section>
						<h2 id={`y${year}`}>{year}</h2>
						<ol>
							{yearEvents.map(({ entry, Content }) => (
								<li id={entry.id} class={`cat-${entry.data.category}`}>
									<p class="when">
										<time datetime={entry.data.date.toISOString().slice(0, 10)}>
											{formatDate(entry.data.date)}
										</time>
										<span class="chip">{categoryLabel(entry.data.category)}</span>
									</p>
									<p class="thanks">{entry.data.thanks}</p>
									{entry.data.figure && (
										<p class="figure">
											<strong>{entry.data.figure.value}</strong>
											<span>{entry.data.figure.label}</span>
										</p>
									)}
									{entry.data.image && (
										<figure class="photo">
											<Image
												src={entry.data.image.src}
												alt={entry.data.image.alt}
												widths={[480, 800, 1280]}
												sizes="(min-width: 46rem) 42rem, 92vw"
												style={entry.data.image.position && `object-position: ${entry.data.image.position}`}
											/>
											<figcaption>
												Photo: <a href={entry.data.image.creditUrl} rel="noopener">{entry.data.image.credit}</a>
											</figcaption>
										</figure>
									)}
									<h3>{entry.data.title}</h3>
									<div class="body">
										<Content />
									</div>
									<dl>
										<div>
											<dt>Courtesy of</dt>
											<dd>{entry.data.actors.join(', ')}</dd>
										</div>
										<div>
											<dt>Paid for by</dt>
											<dd>{scopeLabel[entry.data.scope]}</dd>
										</div>
										<div>
											<dt>Sources</dt>
											<dd>
												{entry.data.sources.map((source) => (
													<a href={source.url} rel="noopener">
														{source.title}
													</a>
												))}
											</dd>
										</div>
									</dl>
								</li>
							))}
						</ol>
					</section>
				))
			}
		</main>

		<footer>
			<p>Every entry links to its sources. The gratitude is sarcastic; the facts are not.</p>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: light-dark(#f4efe6, #171514);
		--card: light-dark(#fffdf8, #201d1b);
		--text: light-dark(#1d1b19, #ece7df);
		--muted: light-dark(#6b655d, #a29a8f);
		--rule: light-dark(#d9d2c6, #3a3531);
		--accent: light-dark(#a3261b, #ef7a6c);
		--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
		--sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
	}

	/* One hue per category, used for the timeline dot and the chip. */
	.cat-democracy { --cat: light-dark(#4338ca, #a5b4fc); }
	.cat-civil-rights { --cat: light-dark(#86198f, #e9a8f2); }
	.cat-climate { --cat: light-dark(#15803d, #86d9a0); }
	.cat-health { --cat: light-dark(#0f766e, #6fd3c7); }
	.cat-economy { --cat: light-dark(#a16207, #e6c15c); }
	.cat-foreign-policy { --cat: light-dark(#1d4ed8, #93b4f8); }
	.cat-immigration { --cat: light-dark(#c2410c, #f5a57a); }
	.cat-justice { --cat: light-dark(#475569, #b3bfce); }

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 1rem;
	}

	body {
		margin: 0;
		padding: 0 1rem;
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		line-height: 1.6;
	}

	header,
	main,
	footer {
		max-width: 44rem;
		margin-inline: auto;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.15em;
	}

	/* Header: a formal thank-you card. */

	header {
		padding-block: 2rem 0;
	}

	.card {
		padding: clamp(1.5rem, 6vw, 3rem);
		background: var(--card);
		border: 1px solid var(--rule);
		/* A second, inset rule, like printed stationery. */
		box-shadow:
			inset 0 0 0 5px var(--card),
			inset 0 0 0 6px var(--rule);
	}

	/* Keep the floated seal inside the card. */
	.card::after {
		content: '';
		display: block;
		clear: both;
	}

	.seal {
		float: right;
		width: clamp(5rem, 22vw, 8rem);
		margin: -0.25rem -0.25rem 0.5rem 1rem;
		color: var(--accent);
		font-family: var(--sans);
		letter-spacing: 0.12em;
		rotate: 10deg;
		shape-outside: circle();
	}

	.overline {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 1rem;
		font-family: var(--serif);
		font-size: clamp(2.25rem, 9vw, 4rem);
		font-style: italic;
		font-weight: 600;
		line-height: 1.05;
		text-wrap: balance;
	}

	.lede {
		margin: 0 0 1.75rem;
		font-size: 1.125rem;
		text-wrap: pretty;
	}

	.signature {
		margin: 0;
		color: var(--muted);
		font-family: var(--serif);
		font-style: italic;
	}

	.signature span {
		display: block;
		color: var(--text);
		font-size: 1.375rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.875rem;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-variant-numeric: tabular-nums;
	}

	/* Timeline. */

	h2 {
		margin: 2.5rem 0 1.5rem;
		font-family: var(--serif);
		font-size: clamp(2.5rem, 10vw, 3.5rem);
		font-variant-numeric: tabular-nums;
		line-height: 1;
		color: var(--accent);
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid var(--rule);
	}

	ol > li {
		position: relative;
		padding: 0 0 3rem 1.5rem;
	}

	ol > li::before {
		content: '';
		position: absolute;
		left: -8px;
		top: 0.3rem;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--cat);
		box-shadow: 0 0 0 4px var(--bg);
	}

	.when {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		margin: 0;
	}

	time {
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.chip {
		padding: 0.0625rem 0.5rem;
		border: 1px solid color-mix(in srgb, var(--cat) 45%, transparent);
		border-radius: 999px;
		color: var(--cat);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: capitalize;
	}

	.thanks {
		margin: 0.375rem 0 0.75rem;
		font-family: var(--serif);
		font-size: clamp(1.5rem, 5vw, 1.875rem);
		font-style: italic;
		line-height: 1.25;
		text-wrap: balance;
	}

	.figure {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin: 0 0 1rem;
	}

	.figure strong {
		color: var(--accent);
		font-family: var(--serif);
		font-size: clamp(2.75rem, 12vw, 4rem);
		font-variant-numeric: lining-nums;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
		white-space: nowrap;
	}

	.figure span {
		max-width: 11rem;
		padding-left: 0.875rem;
		border-left: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.35;
		text-wrap: balance;
	}

	.photo {
		margin: 0 0 1rem;
	}

	.photo img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 4px;
		background: var(--rule);
	}

	.photo figcaption {
		margin-top: 0.375rem;
		color: var(--muted);
		font-size: 0.75rem;
	}

	.photo figcaption a {
		color: inherit;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.body :global(p) {
		margin: 0 0 0.75rem;
		text-wrap: pretty;
	}

	dl {
		display: grid;
		gap: 0.25rem;
		margin: 1rem 0 0;
		font-size: 0.875rem;
	}

	dl div {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 0.75rem;
	}

	dt {
		color: var(--muted);
	}

	dd {
		margin: 0;
		min-width: 0;
	}

	dd a {
		display: block;
	}

	dd a + a {
		margin-top: 0.375rem;
	}

	footer {
		padding-block: 2rem 4rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
